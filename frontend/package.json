{
  "name": "keel-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:subscription": "node scripts/verify-subscription-integration.mjs",
    "verify:entitlements": "node scripts/verify-entitlement-integration.mjs",
    "test:tenant-notifications": "node --test --test-reporter=spec tests/tenant-notifications-today.test.mjs",
    "test:auth-email-verification": "node --test tests/auth-email-verification.test.mjs",
    "test:billing:frontend": "node scripts/run-frontend-billing-production-tests.mjs",
    "test:billing:frontend:release": "npm run verify:subscription && npm run verify:entitlements && npm run test:billing:frontend && npm run build",
    "test:platform-admin-route-access": "node --test tests/platform-admin-route-access.test.mjs",
    "test:api-errors": "node --test tests/api-error-messages.test.mjs",
    "test:connected-data-sources": "node --test tests/connected-data-sources-feature.test.mjs",
    "test:sales-import": "node --test tests/sales-import-completeness.test.mjs",
    "test:dashboard-analytics:contract": "node --test tests/dashboard-analytics-import.test.mjs tests/dashboardAggregate.test.mjs",
    "dev:ui-test": "vite --mode ui-testing",
    "test:ui-preview": "node --test tests/ui-testing-preview.test.mjs tests/ui-testing-fixtures.test.mjs",
    "test:market-intelligence": "node --test tests/market-intelligence-fixes.test.mjs",
    "test:market-perception": "node --test tests/market-perception.test.mjs",
    "test:demand-prediction": "node --test tests/forecasting-feature.test.mjs",
    "test:inventory-intelligence": "node --test tests/inventory-intelligence.test.mjs tests/forecasting-feature.test.mjs tests/dashboard-analytics-import.test.mjs",
    "test:product-catalog": "node --test tests/product-catalog.test.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "test:i18n": "node --test tests/i18n-coverage.test.mjs",
    "test:i18n:render": "node --import ./scripts/register-jsx-tests.mjs --test tests/i18n-render.test.mjs tests/shopify-connection-render.test.mjs tests/store-connection-render.test.mjs tests/pricing-evidence-render.test.mjs tests/business-evidence-render.test.mjs tests/rag-citations-render.test.mjs tests/connect-data-i18n-render.test.mjs tests/pricing-recommendation-render.test.mjs tests/rag-session-header-render.test.mjs",
    "test:competitor-boundary": "node --import ./scripts/register-jsx-tests.mjs --test tests/competitor-bridge-disabled-render.test.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "latest",
    "axios": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "recharts": "latest",
    "swr": "^2.5.1",
    "zustand": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "^10.5.5",
    "tailwindcss": "^3.4.19",
    "vite": "latest"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
