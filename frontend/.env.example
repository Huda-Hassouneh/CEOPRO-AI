# Address of the KEEL backend API.
VITE_API_BASE_URL=http://localhost:8000

# Optional 3D landing hero: the public URL of a Spline scene export
# (https://prod.spline.design/<id>/scene.splinecode). Empty = static hero.
VITE_SPLINE_HERO_SCENE=

# Error tracking (Sentry) for the browser app - optional; leave empty to keep
# it off. The Sentry library is only downloaded when this is set.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
