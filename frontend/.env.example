# KEEL frontend environment example. Copy to .env; never commit real secrets.
# See docs/ENVIRONMENT.md for requirement levels, profiles and source locations.
# Optional assignments stay commented: blank numeric values can break Python parsers.

# ============================================
# APPLICATION, OBSERVABILITY AND TEST TOOLS
# ============================================
# Public Node API origin compiled into the browser application.
# Local default / profile setting; consumer: frontend/src/features/auth/pages/VerifyEmailPage.jsx:53
VITE_API_BASE_URL=http://localhost:5000
# Development auth integration mode; inspect shared API configuration before overriding.
# Optional public/dev setting; consumer: frontend/src/features/auth/api/authApi.js:8
# VITE_AUTH_API_MODE=
# Development auth preview switch; leave false for real integration testing.
# Local default / profile setting; consumer: frontend/src/app/router/ProtectedRoute.jsx:10
VITE_ENABLE_AUTH_PREVIEW=false
# Development onboarding preview switch; leave false for real integration testing.
# Local default / profile setting; consumer: frontend/src/app/router/OnboardingGuard.jsx:13
VITE_ENABLE_ONBOARDING_PREVIEW=false
# Development ui testing mode switch; leave false for real integration testing.
# Local default / profile setting; consumer: frontend/src/shared/config/uiTestingMode.js:8
VITE_ENABLE_UI_TESTING_MODE=false
# Optional public WebSocket endpoint; no corresponding Node WebSocket server is supplied.
# Optional public/dev setting; consumer: frontend/src/shared/lib/websocketClient.js:2
# VITE_WS_URL=
