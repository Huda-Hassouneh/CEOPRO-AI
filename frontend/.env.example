# Manual Vite reference; native dev.ps1 generates /api and the exact proxy target
# without reading this file. VITE_* values are public browser configuration:
# never place a password, bearer token or provider API key here.
# Address of the KEEL backend API for a separately configured manual runtime.
VITE_API_BASE_URL=http://localhost:8000

# Optional 3D landing hero: the public URL of a Spline scene export
# (https://prod.spline.design/<id>/scene.splinecode). Empty = static hero.
VITE_SPLINE_HERO_SCENE=

# Error tracking (Sentry) for the browser app - optional; leave empty to keep
# it off. The Sentry library is only downloaded when this is set.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Optional contact address used in legal/help/pricing surfaces.
VITE_SUPPORT_EMAIL=
# Optional release identifier sent with Sentry events.
VITE_SENTRY_RELEASE=
