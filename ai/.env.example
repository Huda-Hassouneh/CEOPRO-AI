# ============================================
# DATABASE AND ROLE BOUNDARIES
# ============================================
# Ai test database url endpoint for the referenced consumer; enable only that workflow.
# Optional / standalone Python profile; consumer: ai/scripts/live_llm_verification.py:169
# AI_TEST_DATABASE_URL=
# ceopro_app password used by Python tenant pools; must match the runtime role on DATABASE_URL host/database.
# Required for indicated profile; consumer: ai/docker-compose.yml:214
APP_DB_PASSWORD=REPLACE_WITH_APP_PASSWORD
# App db pool max size setting for the referenced consumer; leave unset unless configuring that workflow.
# Optional; required when consumer enabled; consumer: ai/docker-compose.yml:402
# APP_DB_POOL_MAX_SIZE=10
# App db pool min size setting for the referenced consumer; leave unset unless configuring that workflow.
# Optional; required when consumer enabled; consumer: ai/docker-compose.yml:401
# APP_DB_POOL_MIN_SIZE=1
# App db pool wait duration in seconds. Leave unset to keep the consumer default.
# Optional / standalone Python profile; consumer: ai/src/infrastructure/db_pool.py:241
# APP_DB_POOL_WAIT_SECONDS=10
# Restricted ceopro_app connection for canonical runtime queries; migrations use a separate administrator.
# Required for indicated profile; consumer: ai/scripts/apply_migrations.py:45
DATABASE_URL=postgresql://ceopro_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:5433/KEEL_DEV
# Database name (root Compose creates it only on the first volume initialization).
# Optional / standalone Python profile; consumer: ai/docker-compose.yml:16
# POSTGRES_DB=
# Postgres host setting for the referenced consumer; leave unset unless configuring that workflow.
# Optional / standalone Python profile; consumer: ai/src/infrastructure/check_connectivity.py:13
# POSTGRES_HOST=localhost
# Local administrator password. Changing the env file does not rotate an initialized volume.
# Optional / standalone Python profile; consumer: ai/docker-compose.yml:213
# POSTGRES_PASSWORD=
# Postgres port setting for the referenced consumer; leave unset unless configuring that workflow.
# Optional / standalone Python profile; consumer: ai/src/infrastructure/check_connectivity.py:14
# POSTGRES_PORT=5432
# Initial PostgreSQL administrator for local infrastructure; not the runtime application role.
# Optional / standalone Python profile; consumer: ai/docker-compose.yml:16
# POSTGRES_USER=
# Restricted collector database connection; no administrative privilege bypass.
# Required for indicated profile; consumer: ai/scripts/run_e2e_pipeline.py:266
SCRAPER_DATABASE_URL=postgresql://ceopro_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:5433/KEEL_DEV
