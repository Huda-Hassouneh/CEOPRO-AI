FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY src/ai/requirements.txt /tmp/ai-requirements.txt
RUN pip install -r /tmp/ai-requirements.txt
COPY . /app

RUN useradd --create-home --uid 10002 analyst && chown -R analyst:analyst /app
USER analyst

CMD ["python", "-m", "src.market_scraper.analysis_worker"]
