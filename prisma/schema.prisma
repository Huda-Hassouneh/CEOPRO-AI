generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model AppConfig {
  key       String   @id @db.VarChar(100)
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_config")
}

model Company {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @map("tenant_id") @db.Uuid
  businessName            String                    @map("business_name") @db.VarChar(255)
  businessType            String?                   @map("business_type") @db.VarChar(100)
  countryCode             String                    @map("country_code") @db.VarChar(2)
  operatingCountries      String[]                  @default([]) @map("operating_countries")
  primaryCurrency         String                    @map("primary_currency") @db.VarChar(3)
  supportedCurrencies     String[]                  @default(["JOD"]) @map("supported_currencies")
  timezone                String                    @default("Asia/Amman") @db.VarChar(64)
  preferredLanguage       String                    @default("en") @map("preferred_language") @db.VarChar(5)
  supportedLanguages      String[]                  @default(["en"]) @map("supported_languages")
  createdAt               DateTime?                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime?                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  platformStatus          String                    @default("active") @map("platform_status") @db.VarChar(20)
  platformNotes           String?                   @map("platform_notes") @db.VarChar(2000)
  authSessions            AuthSession[]
  campaigns               campaigns[]
  customPlanQuotes        CustomPlanQuote[]
  data_sources            data_sources[]
  demand_forecasts        demand_forecasts[]
  extracted_entity        extracted_entity[]
  global_competitors      global_competitors[]
  inventory               inventory[]
  invoices                invoices[]
  market_alert_events     market_alert_events[]
  market_events           market_events[]
  news_record             news_record[]
  customPlans             Plan[]
  platformInvitations     PlatformInvitation[]
  products                products[]
  rag_documents_metadata  rag_documents_metadata[]
  recommendation_outcomes recommendation_outcomes[]
  reviews                 reviews[]
  social_mention          social_mention[]
  subscriptions           Subscription[]
  system_alerts           system_alerts[]
  tenant_competitors      tenant_competitors[]
  tenantUsers             TenantUser[]
  transactions            transactions[]

  @@map("companies")
}

model Plan {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String           @db.VarChar(50)
  name_ar                  String           @db.VarChar(50)
  tierLevel                Int?             @map("tier_level")
  planType                 PlanType         @default(standard) @map("plan_type")
  tenantId                 String?          @map("tenant_id") @db.Uuid
  description              String?
  description_ar           String?
  price                    Decimal          @db.Decimal(10, 2)
  currency                 String           @default("JOD") @db.VarChar(3)
  billingIntervalValue     Int              @map("billing_interval_value")
  billingIntervalUnit      String           @map("billing_interval_unit") @db.VarChar(10)
  trialPeriodValue         Int              @default(0) @map("trial_period_value")
  paymentProviderProductId String?          @map("payment_provider_product_id") @db.VarChar(255)
  paymentProviderPlanId    String?          @unique @map("payment_provider_plan_id") @db.VarChar(255)
  billingOptions           Json?            @map("billing_options")
  isActive                 Boolean          @default(true) @map("is_active")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sourceQuote              CustomPlanQuote? @relation("QuoteCreatedPlan")
  planFeatures             PlanFeature[]
  tenant                   Company?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  promoCodes               PromoCodePlan[]
  activeSubscriptions      Subscription[]   @relation("ActivePlan")
  scheduledSubscriptions   Subscription[]   @relation("ScheduledPlan")
  priceVersions            PlanPriceVersion[]

  @@index([tenantId])
  @@index([planType, isActive])
  @@map("plans")
}

// A Stripe Price remains the source of truth for its subscribers even after the
// owner edits or removes the option from the public plan catalog.
model PlanPriceVersion {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId             String   @map("plan_id") @db.Uuid
  stripePriceId      String   @unique @map("stripe_price_id") @db.VarChar(255)
  periodCode         String   @map("period_code") @db.VarChar(100)
  intervalUnit       String?  @map("interval_unit") @db.VarChar(10)
  intervalCount      Int?     @map("interval_count")
  amount             Decimal? @db.Decimal(10, 2)
  currency           String   @db.VarChar(3)
  retiredAt          DateTime? @map("retired_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  plan               Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, retiredAt])
  @@map("plan_price_versions")
}

model PromoCode {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String                @unique @db.VarChar(50)
  discountType          String                @map("discount_type") @db.VarChar(20)
  discountValue         Decimal               @map("discount_value") @db.Decimal(10, 2)
  maxUses               Int                   @map("max_uses")
  paymentProviderCoupon String                @map("payment_provider_coupon_id")
  usedCount             Int                   @default(0) @map("used_count")
  maxUsesPerUser        Int                   @default(1) @map("max_uses_per_user")
  startsAt              DateTime              @map("starts_at") @db.Timestamptz(6)
  expiresAt             DateTime              @map("expires_at") @db.Timestamptz(6)
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  redemptions           PromoCodeRedemption[]
  plans                 PromoCodePlan[]

  @@map("promo_codes")
}

model PromoCodePlan {
  promoCodeId String    @map("promo_code_id") @db.Uuid
  planId      String    @map("plan_id") @db.Uuid
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, planId])
  @@map("promo_codes_plans")
}

model Subscription {
  id                            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                      String                @map("tenant_id") @db.Uuid
  planId                        String                @map("plan_id") @db.Uuid
  scheduledPlanId               String?               @map("scheduled_plan_id") @db.Uuid
  paymentProvider               String                @map("payment_provider") @db.VarChar(50)
  paymentProviderCustomerId     String?               @map("payment_provider_customer_id") @db.VarChar(255)
  paymentProviderSubscriptionId String?               @unique @map("payment_provider_subscription_id") @db.VarChar(255)
  paymentProviderPriceId        String?               @map("payment_provider_price_id")
  billingPeriod                 String?               @map("billing_period")
  status                        String                @db.VarChar(30)
  currentPeriodStart            DateTime              @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd              DateTime              @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd             Boolean               @default(false) @map("cancel_at_period_end")
  cancelledAt                   DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  createdAt                     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  scheduledBillingPeriod        String?               @map("scheduled_billing_period")
  paymentTransactions           PaymentTransaction[]
  promoCodeRedemptions          PromoCodeRedemption[]
  subscriptionUsages            SubscriptionUsage[]
  plan                          Plan                  @relation("ActivePlan", fields: [planId], references: [id])
  scheduledPlan                 Plan?                 @relation("ScheduledPlan", fields: [scheduledPlanId], references: [id])
  tenant                        Company               @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)], map: "subscriptions_owner_portal_latest_idx")
  @@map("subscriptions")
}

model PaymentTransaction {
  id                              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId                  String       @map("subscription_id") @db.Uuid
  payment_providerPaymentIntentId String?      @unique @map("payment_intent_id") @db.VarChar(255)
  payment_providerInvoiceId       String?      @map("payment_provider_invoice_id") @db.VarChar(255)
  idempotencyKey                  String?      @unique @map("idempotency_key") @db.VarChar(320)
  amount                          Decimal      @db.Decimal(12, 2)
  currency                        String       @db.VarChar(3)
  status                          String       @default("pending") @db.VarChar(20)
  paidAt                          DateTime?    @map("paid_at") @db.Timestamptz(6)
  failureReason                   String?      @map("failure_reason")
  createdAt                       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime     @default(now()) @updatedAt @map("updated_at")
  subscription                    Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("payment_transactions")
}

model PromoCodeRedemption {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promoCodeId    String       @map("promo_code_id") @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  redeemedAt     DateTime     @default(now()) @map("redeemed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  promoCode      PromoCode    @relation(fields: [promoCodeId], references: [id])
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  @@unique([promoCodeId, subscriptionId])
  @@map("promo_code_redemptions")
}

model payment_providerWebhookEvent {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_providerEventId String    @unique @map("payment_provider_event_id") @db.VarChar(255)
  eventType               String    @map("event_type") @db.VarChar(100)
  processed               Boolean   @default(false)
  processedAt             DateTime? @map("processed_at") @db.Timestamptz(6)
  payload                 Json
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("payment_provider_webhook_events")
}

model Feature {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @map("feature_id") @db.Uuid
  code                String                   @unique @map("feature_code")
  name                String                   @map("feature_name")
  name_ar             String                   @map("feature_name_ar")
  type                FeatureType              @map("feature_type")
  description         String?
  description_ar      String?
  unit                String?                  @db.VarChar(50)
  unit_ar             String?                  @db.VarChar(50)
  aggregationType     AggregationType          @default(sum) @map("aggregation_type")
  resetCycle          ResetCycle               @default(billing_period) @map("reset_cycle")
  created_at          DateTime                 @default(now())
  updated_at          DateTime                 @default(now()) @updatedAt
  customQuoteFeatures CustomPlanQuoteFeature[]
  plan_features       PlanFeature[]
  subscription_usage  SubscriptionUsage[]
  vendorRates         VendorRate[]
  infrastructureRates InfrastructureRate[]

  @@map("features")
}

model PlanFeature {
  plan_id     String  @db.Uuid
  feature_id  String  @db.Uuid
  limit_value Int?
  metadata    Json?
  feature     Feature @relation(fields: [feature_id], references: [id], onDelete: Cascade)
  plan        Plan    @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@id([plan_id, feature_id])
  @@map("plan_features")
}

model SubscriptionUsage {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscription_id String       @db.Uuid
  feature_id      String       @db.Uuid
  current_usage   Int          @default(0)
  period_start    DateTime     @db.Timestamptz(6)
  period_end      DateTime     @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  feature         Feature      @relation(fields: [feature_id], references: [id], onDelete: Cascade)
  subscription    Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@unique([subscription_id, feature_id, period_start])
  @@map("subscription_usage")
}

model VendorRate {
  id                    String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  featureId             String?                      @map("feature_id") @db.Uuid
  vendor                String                       @db.VarChar(100)
  service               String                       @db.VarChar(150)
  billingUnit           String                       @map("billing_unit") @db.VarChar(80)
  unitCost              Decimal                      @map("unit_cost") @db.Decimal(14, 6)
  currency              String                       @db.VarChar(3)
  operationalMultiplier Decimal                      @default(1) @map("operational_multiplier") @db.Decimal(8, 4)
  variabilityReserve    Decimal                      @default(1) @map("variability_reserve") @db.Decimal(8, 4)
  effectiveFrom         DateTime                     @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo           DateTime?                    @map("effective_to") @db.Timestamptz(6)
  verificationStatus    VendorRateVerificationStatus @default(unconfirmed) @map("verification_status")
  source                String?
  metadata              Json?
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  feature               Feature?                     @relation(fields: [featureId], references: [id])

  @@index([featureId, effectiveFrom])
  @@index([vendor, service])
  @@map("vendor_rates")
}

model InfrastructureRate {
  id                         String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  featureId                  String?                              @map("feature_id") @db.Uuid
  costDriver                 String                               @map("cost_driver") @db.VarChar(100)
  usageBasis                 InfrastructureRateUsageBasis         @default(estimated_usage) @map("usage_basis")
  billingUnit                String                               @map("billing_unit") @db.VarChar(80)
  billingUnitsPerFeatureUnit Decimal                              @default(1) @map("billing_units_per_feature_unit") @db.Decimal(18, 10)
  unitCost                   Decimal                              @map("unit_cost") @db.Decimal(14, 6)
  currency                   String                               @db.VarChar(3)
  operationalMultiplier      Decimal                              @default(1) @map("operational_multiplier") @db.Decimal(8, 4)
  variabilityReserve         Decimal                              @default(1) @map("variability_reserve") @db.Decimal(8, 4)
  effectiveFrom              DateTime                             @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo                DateTime?                           @map("effective_to") @db.Timestamptz(6)
  verificationStatus         InfrastructureRateVerificationStatus @default(unconfirmed) @map("verification_status")
  source                     String?
  metadata                   Json?
  createdAt                  DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  feature                    Feature?                             @relation(fields: [featureId], references: [id])

  @@index([featureId, effectiveFrom])
  @@index([costDriver, effectiveFrom])
  @@index([verificationStatus])
  @@map("infrastructure_rates")
}

model CustomPlanQuote {
  id                          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                    String                   @map("tenant_id") @db.Uuid
  name                        String                   @db.VarChar(50)
  nameAr                      String                   @map("name_ar") @db.VarChar(50)
  description                 String?
  descriptionAr               String?                  @map("description_ar")
  status                      CustomPlanQuoteStatus    @default(draft)
  currency                    String                   @default("JOD") @db.VarChar(3)
  billingIntervalValue        Int                      @default(1) @map("billing_interval_value")
  billingIntervalUnit         String                   @default("month") @map("billing_interval_unit") @db.VarChar(10)
  trialPeriodValue            Int                      @default(0) @map("trial_period_value")
  billingOptions              Json                     @map("billing_options")
  estimatedVendorCost         Decimal                  @default(0) @map("estimated_vendor_cost") @db.Decimal(12, 2)
  estimatedInfrastructureCost Decimal                  @default(0) @map("estimated_infrastructure_cost") @db.Decimal(12, 2)
  estimatedOtherCost          Decimal                  @default(0) @map("estimated_other_cost") @db.Decimal(12, 2)
  estimatedTotalCost          Decimal                  @default(0) @map("estimated_total_cost") @db.Decimal(12, 2)
  targetGrossMargin           Decimal                  @default(0.2) @map("target_gross_margin") @db.Decimal(7, 6)
  maxVendorCostRevenueRatio   Decimal                  @default(0.2) @map("max_vendor_cost_revenue_ratio") @db.Decimal(7, 6)
  grossMarginFloor            Decimal                  @default(0) @map("gross_margin_floor") @db.Decimal(12, 2)
  vendorCostRatioFloor        Decimal                  @default(0) @map("vendor_cost_ratio_floor") @db.Decimal(12, 2)
  minimumSafePrice            Decimal                  @default(0) @map("minimum_safe_price") @db.Decimal(12, 2)
  finalPrice                  Decimal?                 @map("final_price") @db.Decimal(12, 2)
  fxRate                      Decimal?                 @map("fx_rate") @db.Decimal(18, 8)
  fxSourceCurrency            String?                  @map("fx_source_currency") @db.VarChar(3)
  fxTargetCurrency            String?                  @map("fx_target_currency") @db.VarChar(3)
  fxSource                    String?                  @map("fx_source") @db.VarChar(255)
  fxRateAt                    DateTime?                @map("fx_rate_at") @db.Timestamptz(6)
  pricingInputs               Json?                    @map("pricing_inputs")
  pricingSnapshot             Json?                    @map("pricing_snapshot")
  overrideReason              String?                  @map("override_reason")
  createdBy                   String?                  @map("created_by") @db.Uuid
  approvedBy                  String?                  @map("approved_by") @db.Uuid
  createdPlanId               String?                  @unique @map("created_plan_id") @db.Uuid
  expiresAt                   DateTime?                @map("expires_at") @db.Timestamptz(6)
  acceptedAt                  DateTime?                @map("accepted_at") @db.Timestamptz(6)
  createdAt                   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  quoteFeatures               CustomPlanQuoteFeature[]
  createdPlan                 Plan?                    @relation("QuoteCreatedPlan", fields: [createdPlanId], references: [id])
  tenant                      Company                  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([createdAt])
  @@map("custom_plan_quotes")
}

model CustomPlanQuoteFeature {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId        String          @map("quote_id") @db.Uuid
  featureId      String          @map("feature_id") @db.Uuid
  limitValue     Int?            @map("limit_value")
  estimatedUsage Decimal         @default(0) @map("estimated_usage") @db.Decimal(14, 4)
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  feature        Feature         @relation(fields: [featureId], references: [id])
  quote          CustomPlanQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, featureId])
  @@index([featureId])
  @@map("custom_plan_quote_features")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  userId                  String               @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  email                   String               @db.VarChar(255)
  passwordHash            String               @map("password_hash")
  fullName                String?              @map("full_name") @db.VarChar(150)
  preferredLanguage       String?              @default("en") @map("preferred_language") @db.VarChar(5)
  createdAt               DateTime?            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime?            @default(now()) @map("updated_at") @db.Timestamptz(6)
  sessionVersion          Int                  @default(0) @map("session_version")
  authSessions            AuthSession[]
  sentPlatformInvitations PlatformInvitation[]
  tenantUsers             TenantUser[]

  @@map("users")
}

model SystemRole {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @map("role_id") @db.Uuid
  roleKey     String       @unique @map("role_key") @db.VarChar(50)
  roleName    String       @map("role_name") @db.VarChar(100)
  permissions Json         @default("{}")
  createdAt   DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantUsers TenantUser[]

  @@map("system_roles")
}

model TenantUser {
  id                                                           String                   @id @default(dbgenerated("gen_random_uuid()")) @map("tenant_user_id") @db.Uuid
  tenantId                                                     String                   @map("tenant_id") @db.Uuid
  userId                                                       String                   @map("user_id") @db.Uuid
  roleKey                                                      String                   @map("role_key") @db.VarChar(50)
  removedAt                                                    DateTime?                @map("removed_at") @db.Timestamptz(6)
  joinedAt                                                     DateTime?                @default(now()) @map("joined_at") @db.Timestamptz(6)
  platformStatus                                               String                   @default("active") @map("platform_status") @db.VarChar(20)
  invoices                                                     invoices[]
  product_price_history                                        product_price_history[]
  products_products_tenant_id_created_by_user_idTotenant_users products[]               @relation("products_tenant_id_created_by_user_idTotenant_users")
  products_products_tenant_id_updated_by_user_idTotenant_users products[]               @relation("products_tenant_id_updated_by_user_idTotenant_users")
  rag_documents_metadata                                       rag_documents_metadata[]
  role                                                         SystemRole               @relation(fields: [roleKey], references: [roleKey], onDelete: NoAction, onUpdate: NoAction)
  tenant                                                       Company                  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                                                         User                     @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, userId], map: "uq_tenant_user_composite_perimeter")
  @@map("tenant_users")
}

model PlatformInvitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String    @db.VarChar(255)
  roleKey    String    @map("role_key") @db.VarChar(50)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  invitedBy  String    @map("invited_by") @db.Uuid
  status     String    @default("pending") @db.VarChar(20)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  inviter    User      @relation(fields: [invitedBy], references: [userId], onDelete: Cascade)
  tenant     Company   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, email])
  @@map("platform_invitations")
}

model AuthSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  device     String    @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActive DateTime  @default(now()) @map("last_active") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  tenant     Company   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
