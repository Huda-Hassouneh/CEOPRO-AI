  competitor_price_id         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                   String                      @db.Uuid
  mapping_id                  String                      @db.Uuid
  scraped_price               Decimal                     @db.Decimal(12, 4)
  currency                    String                      @db.VarChar(3)
  is_available                Boolean                     @default(true)
  observed_at                 DateTime                    @default(now()) @db.Timestamptz(6)
  competitor_product_mappings competitor_product_mappings @relation(fields: [tenant_id, mapping_id], references: [tenant_id, mapping_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_competitor_prices_mapping_isolated")

  @@index([tenant_id, observed_at(sort: Desc)], map: "idx_competitor_prices_lookup")
  @@index([tenant_id, mapping_id], map: "idx_competitor_prices_mapping")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model competitor_product_mappings {
  mapping_id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String              @db.Uuid
  global_competitor_id   String              @db.Uuid
  product_id             String              @db.Uuid
  competitor_product_url String?
  competitor_product_sku String?             @db.VarChar(100)
  is_active              Boolean             @default(true)
  created_at             DateTime?           @default(now()) @db.Timestamptz(6)
  competitor_prices      competitor_prices[]
  products               products            @relation(fields: [tenant_id, product_id], references: [tenant_id, product_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mapping_product_isolated")
  tenant_competitors     tenant_competitors  @relation(fields: [tenant_id, global_competitor_id], references: [tenant_id, global_competitor_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mapping_tenant_competitor")

  @@unique([tenant_id, global_competitor_id, product_id], map: "uq_tenant_competitor_product")
