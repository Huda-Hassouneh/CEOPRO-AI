  @@index([tenant_id, product_id], map: "idx_mappings_tenant_product")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model currency_rates {
  rate_id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_currency String    @db.VarChar(3)
  to_currency   String    @db.VarChar(3)
  exchange_rate Decimal   @db.Decimal(12, 6)
  last_fetched  DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([from_currency, to_currency], map: "uq_currency_pair")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model data_sources {
  source_id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                    String           @db.Uuid
  source_name                  String           @db.VarChar(100)
  source_type                  String           @db.VarChar(50)
  connection_credentials_vault String?
  sync_frequency_minutes       Int?             @default(1440)
  is_active                    Boolean          @default(true)
  created_at                   DateTime?        @default(now()) @db.Timestamptz(6)
  companies                    Company          @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingestion_jobs               ingestion_jobs[]

  @@unique([tenant_id, source_id], map: "uq_tenant_source_perimeter")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model demand_forecasts {
  forecast_id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String                    @db.Uuid
  product_id              String                    @db.Uuid
  forecast_start_date     DateTime                  @db.Date
  forecast_end_date       DateTime                  @db.Date
  predicted_quantity      Decimal                   @db.Decimal(12, 2)
  confidence_lower_bound  Decimal?                  @db.Decimal(12, 2)
