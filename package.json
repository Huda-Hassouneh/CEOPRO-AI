{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:auth-onboarding && npm run test:routes && npm run test:security && npm run test:custom-plan && npm run test:features",
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/server.js",
    "validate": "npm run prisma:validate && npm run build && npm test",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "prisma:migrate:test": "prisma migrate deploy --config prisma7.config.ts",
    "prisma:seed": "tsx prisma/seed/main.ts",
    "seed:dashboard": "tsx prisma/seed/dashboard-metrics.ts",
    "bootstrap:owner": "tsx prisma/bootstrap/owner.ts",
    "bootstrap:admin": "tsx prisma/bootstrap/admin.ts",
    "bootstrap:features": "tsx prisma/bootstrap/features.ts",
    "bootstrap:stripe": "tsx prisma/bootstrap/stripe.ts",
    "bootstrap:plans": "tsx prisma/bootstrap/plans-production.ts",
    "bootstrap:plans:dry-run": "tsx prisma/bootstrap/plans-production.ts --dry-run",
    "verify:plans:production": "tsx prisma/bootstrap/plans-production.ts --verify-only",
    "bootstrap:production": "npm run bootstrap:stripe && npm run bootstrap:plans",
    "bootstrap:production:init": "npm run bootstrap:features && npm run bootstrap:production",
    "bootstrap:production:verify": "npm run verify:plans:production",
    "dev:token": "tsx scripts/dev/generate-mock-token.ts",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test:routes": "node tests/contracts/verify-route-contract.mjs",
    "test:auth-onboarding": "node tests/contracts/verify-auth-onboarding-contract.mjs",
    "test:security": "node tests/contracts/verify-security-regressions.mjs",
    "test:features": "node tests/contracts/verify-feature-entitlements.mjs",
    "test:notifications": "tsx --test tests/platform-notifications/platform-notification-source-contract.test.ts tests/platform-notifications/platform-notification-definition.test.ts tests/platform-notifications/platform-notification-producer.test.ts tests/platform-notifications/platform-notification-migration-contract.test.ts",
    "test:tenant-notifications": "tsx --test tests/tenant-notifications/tenant-notification-definition.test.ts tests/tenant-notifications/tenant-notification-producer.test.ts tests/tenant-notifications/tenant-notification-source-contract.test.ts tests/tenant-notifications/tenant-notification-migration-contract.test.ts",
    "test:rag": "node --test --test-reporter=spec tests/rag/rag-document-upload-contract.test.mjs",
    "test:custom-plan": "node tests/runners/run-custom-plan-tests.mjs",
    "test:custom-plan:contract": "node tests/contracts/verify-custom-plan-contract.mjs",
    "test:custom-plan:db": "node tests/runners/run-custom-plan-tests.mjs --db",
    "test:custom-plan:full": "node tests/runners/run-custom-plan-tests.mjs --full",
    "test:custom-plan:stripe": "node tests/runners/run-custom-plan-stripe-tests.mjs",
    "test:custom-plan:release": "npm run test:custom-plan && npm run test:custom-plan:db && npm run test:custom-plan:stripe",
    "test:subscription:lifecycle": "node tests/runners/run-subscription-lifecycle-tests.mjs",
    "test:billing:release": "npm run test:custom-plan:release && npm run test:subscription:lifecycle",
    "test:plans:production": "node tests/runners/run-production-plan-tests.mjs",
    "test:billing:production": "npm run test:billing:release && npm run test:plans:production",
    "worker:notifications": "tsx src/workers/platform-notification.worker.ts",
    "worker:platform-notifications": "tsx src/workers/platform-notification.worker.ts",
    "worker:tenant-notifications": "tsx src/workers/tenant-notification.worker.ts",
    "worker:data-ingestion": "tsx src/workers/data-ingestion.worker.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/cors": "^2.8.19",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "stripe": "^22.6.2",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
