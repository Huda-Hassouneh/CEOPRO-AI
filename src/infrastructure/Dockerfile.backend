# ==========================================
# STAGE 1: DEPENDENCY BUILDER
# ==========================================
FROM python:3.11-alpine AS backend-builder
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
RUN apk add --no-cache \
    gcc \
    musl-dev \
    postgresql-dev \
    libffi-dev \
    make \
    && apk upgrade --no-cache
COPY requirements.txt .
RUN pip install --upgrade pip \
    && pip install --no-cache-dir --user -r requirements.txt

# ==========================================
# STAGE 2: PRODUCTION RUNTIME
# ==========================================
FROM python:3.11-alpine AS backend-runtime
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH=/home/ceopro/.local/bin:$PATH
ENV HOME=/home/ceopro
RUN apk add --no-cache \
    libpq \
    libffi \
    curl \
    && apk upgrade --no-cache
RUN addgroup -S ceoprogroup && adduser -S ceopro -G ceoprogroup
RUN mkdir -p /app/src /app/mocks /app/tmp /home/ceopro/.local \
    && chown -R ceopro:ceopro /app /home/ceopro
COPY --from=backend-builder /root/.local /home/ceopro/.local
COPY --chown=ceopro:ceopro . .
USER ceopro
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
