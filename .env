
# CEOPRO AI - Phase 1 Core Infrastructure Environment Configuration

# 1. Main Platform Database Connection (PostgreSQL)
POSTGRES_DB=ceopro_platform
POSTGRES_USER=ceopro_admin
POSTGRES_PASSWORD=538c581df4ed75c51a254d3d98547740c93bc2b36837a5c7fb896f8fc5a694a4
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=k8c581df4ed75c51a254d3d98547740c93bc2b36837a5c7fb896f8fc5a694a4@postgres:5432/ceopro_platform

# Password for the restricted, non-superuser ceopro_app role every application
# service should connect as day-to-day (RLS only actually restricts anything
# once the connecting role isn't a superuser - POSTGRES_USER above is the
# bootstrap/superuser role, reserved for running migrations, never for the app).
# Read by scripts/apply_migrations.py to create/update the role; never used to
# construct DATABASE_URL above, which stays on the superuser for migrations.
APP_DB_PASSWORD=3846d062a53a0fae9247f5b27060cd8bc9500f340fd76ec2d15abb71bb3e6d8e

# src/ai/db.py pools ceopro_app connections (src/infrastructure/db_pool.py)
# instead of opening a fresh one per request - RLS context is set via
# SET LOCAL per transaction, which Postgres guarantees cannot survive a
# connection-reuse boundary, so pooling here never risks a cross-tenant
# leak even if reused across different tenants back to back. minconn are
# opened eagerly on first use; maxconn bounds this process's total.
APP_DB_POOL_MIN_SIZE=1
APP_DB_POOL_MAX_SIZE=10

# User/service-principal UUID that is an active tenant member, required by RLS -
# used by src/ai/forecasting/consumer.py (and any other ai/ background worker
# acting on a tenant's behalf with no live end user behind the request) via
# src/ai/db.py::app_role_connection(). Same role SCRAPER_ACTOR_USER_ID plays
# for the market_scraper service below.
AI_SERVICE_ACTOR_USER_ID=00000000-0000-0000-0000-000000000000

# Attempt-tracking/dead-letter/reclaim tuning for src/ai/forecasting/
# consumer.py - same contract as SCRAPER_MAX_ATTEMPTS/SCRAPER_DEAD_STREAM_KEY
# below. A forecast request that keeps failing (a deleted product_id, a
# malformed payload) is retried this many times before moving to the dead
# stream instead of sitting stuck in the consumer group's PEL forever.
AI_FORECAST_DEAD_STREAM_KEY=ceopro:stream:demand_forecast_requested:dead
AI_FORECAST_MAX_ATTEMPTS=3
AI_FORECAST_CLAIM_IDLE_MS=300000

# 2. Fast In-Memory Cache and Message Pipeline (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Market Scraper Service. Use the restricted ceopro_app role in real runs;
# never point the scraper at the migration/superuser connection above.
SCRAPER_DATABASE_URL=postgresql://ceopro_app:change_this_password@localhost:5432/ceopro_platform
# User/service-principal UUID that is an active tenant member; required by RLS.
SCRAPER_ACTOR_USER_ID=00000000-0000-0000-0000-000000000000
# Same pooling mechanism/safety as APP_DB_POOL_MIN_SIZE/MAX_SIZE above, applied
# to this service's own separate connection pool (a different process, so it
# never shares a pool with src/ai/db.py's).
SCRAPER_DB_POOL_MIN_SIZE=1
SCRAPER_DB_POOL_MAX_SIZE=10
SCRAPER_STREAM_KEY=market.scrape.requested
SCRAPER_DEAD_STREAM_KEY=market.scrape.dead
SCRAPER_MAX_ATTEMPTS=3
SCRAPER_CLAIM_IDLE_MS=300000
SCRAPER_STALE_JOB_MINUTES=30
SCRAPER_MAINTENANCE_INTERVAL_SECONDS=300
SCRAPER_USER_AGENT=CEOPRO-MarketResearchBot/1.0 (+https://github.com/Huda-Hassouneh/CEOPRO-AI)

# Attempt-tracking/dead-letter/reclaim tuning for
# src/market_scraper/analysis_worker.py - same contract as
# SCRAPER_MAX_ATTEMPTS/SCRAPER_DEAD_STREAM_KEY above, for the separate
# market.analysis.requested stream (post-scrape sentiment/score/RAG-summary
# refresh) instead of market.scrape.requested.
ANALYSIS_DEAD_STREAM_KEY=market.analysis.dead
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_CLAIM_IDLE_MS=300000

# The automatic upload -> discovery trigger (production-hardening audit
# fix): src/ai/main.py's POST /extraction/upload publishes
# DISCOVERY_STREAM_KEY right after real new products are persisted;
# src/market_scraper/discovery_worker.py consumes it and runs full
# competitor discovery for that tenant. Same attempt-tracking/dead-letter
# contract as SCRAPER_MAX_ATTEMPTS/SCRAPER_DEAD_STREAM_KEY above.
DISCOVERY_STREAM_KEY=market.discovery.requested
DISCOVERY_DEAD_STREAM_KEY=market.discovery.dead
DISCOVERY_MAX_ATTEMPTS=3
DISCOVERY_CLAIM_IDLE_MS=300000

# src/market_scraper/connector_worker.py - the scheduled process that
# actually runs both connector types (connector_sync.py's direct-database
# connector, api_connector_sync.py's generic POS/ERP/API connector) on a
# schedule; a tenant registers one via POST /onboarding/connect/database
# or /onboarding/connect/api. Not event-driven (no stream key here) -
# a client's own system doesn't notify CEOPRO AI when it changes, so this
# polls on an interval instead; each individual source's own
# sync_frequency_minutes (set at registration) still governs how often
# THAT source is actually synced.
CONNECTOR_WORKER_POLL_INTERVAL_SECONDS=300

# 3. Object Cloud Storage Connections (MinIO)
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_this_password

# 4. Multi-Tenancy Core Authentication Token
# Required. The application must fail to start if this is not set.
JWT_SECRET=8a72d8377cdd7d8d84d2a69482c835ac3d399de64db165f3f1b1589ce5563077

# ==============================================================================
# CEOPRO AI - HARDENED TELEMETRY AND LOGGING ENVIRONMENT FIELDS (ADDED 2026)
# ==============================================================================
GRAFANA_ADMIN_USER=ceopro_telemetry_supervisor
GRAFANA_ADMIN_PASSWORD=change_this_password

# Optional. Webhook URL the infra watchdog (src/infrastructure/monitoring/watchdog.py)
# posts to when it detects an ingestion-error-rate or stream-backlog threshold breach.
# Degrades gracefully (no alert sent) if left unset.
ALERT_WEBHOOK_URL=

# ==============================================================================
# CEOPRO AI - RAG CHAT LLM PROVIDER (src/ai/rag/llm_client.py)
# ==============================================================================
# Required for POST /rag/query - without one of the two options below, that
# endpoint fails with a clear LLMError, not a silent wrong answer.

# Option A (default): Groq's hosted, hardware-accelerated API. Free tier
# available - get a key at https://console.groq.com/
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-20b
# Caps response length - a real, free latency lever, not just a Groq
# nicety (an uncapped response is what made this matter enough to cap: it's
# what caused a real httpx.ReadTimeout the first time this ran against
# Option B below, whose generation speed is genuinely much slower).
GROQ_MAX_TOKENS=400

# Retry jitter (production-hardening audit fix) - each retry's linear
# backoff is lengthened by a random 0%-N% (never shortened), spreading
# retries out instead of many concurrent requests retrying in lockstep at
# the exact same intervals during a real provider-wide outage/429 event.
GROQ_RETRY_JITTER_FRACTION=0.5

# Circuit breaker (production-hardening audit fix) - after this many
# consecutive request-level failures (each already exhausted its own
# retries), a new /rag/query call fails fast instead of repeating the
# full retry sequence against a provider that's already known to be down -
# real protection against exhausting the FastAPI thread pool under a
# sustained outage. In-process only, resets on any successful call.
GROQ_CIRCUIT_BREAKER_THRESHOLD=5
GROQ_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Option B: a local, zero-cost llama.cpp server instead of Groq - full data
# privacy, no external API call at all, real measured ~6 tokens/sec on a
# 4-core/8-thread CPU (see scripts/download_local_llm_model.py and
# docker-compose.yml's llm-local service, profile "local-llm"). Leave blank
# to use Groq (Option A) - set this to switch, nothing else changes.
LOCAL_LLM_BASE_URL=
# Local generation is much slower than Groq's hosted hardware - this is
# sized for that, not a arbitrary bigger number.
LOCAL_LLM_TIMEOUT_SECONDS=90

# Option C: a paid subscription vendor (OpenAI, Together AI, Azure OpenAI,
# Fireworks, or any other OpenAI-schema-compatible provider) - the
# flexible placeholder for swapping Groq out later without a rewrite.
# Takes priority over both Option A and Option B when set. Leave blank to
# keep using Groq (or Option B) - this is a config slot, not a live
# integration; no vendor is provisioned here yet.
PAID_LLM_BASE_URL=
PAID_LLM_API_KEY=
# Optional - defaults to GROQ_MODEL's value if left blank.
PAID_LLM_MODEL=
PAID_LLM_TIMEOUT_SECONDS=20

# ==============================================================================
# CEOPRO AI - MARKET DISCOVERY (src/market_scraper/places_discovery.py,
# social_cross_reference.py) - both optional, free-tier, self-serve
# ==============================================================================
# Google Places API (Text Search) - discovers real local competitor
# businesses from a product/industry + region, before anything else in this
# pipeline has ever heard of them. Self-serve at https://console.cloud.google.com/
# (enable "Places API") - no lengthy app review, unlike Meta's Graph API.
GOOGLE_PLACES_API_KEY=

# Google Custom Search JSON API - queries Google's own search index (built
# by Googlebot, which Instagram's and Facebook's own robots.txt explicitly
# permit on public pages) for a competitor's social presence. Free tier:
# 100 queries/day. Needs both a key (Cloud Console, enable "Custom Search
# API") and a Programmable Search Engine ID configured to search the whole
# web, from https://programmablesearchengine.google.com/
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# ==============================================================================
# CEOPRO AI - CREDENTIAL VAULT ENCRYPTION (src/market_scraper/credential_vault.py)
# ==============================================================================
# Every data_sources.connection_credentials_vault value (Apify tokens, PA-API
# keys, a future client DB/ERP connector's credentials) is envelope-encrypted,
# never stored in plaintext. CREDENTIAL_VAULT_KMS_BACKEND selects how the
# per-credential encryption key itself gets protected - "local" (default) or
# "aws_kms".
CREDENTIAL_VAULT_KMS_BACKEND=local

# Required when CREDENTIAL_VAULT_KMS_BACKEND=local (the default - no cloud
# account needed for dev/self-hosted use). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Treat this exactly like a database root password: losing it makes every
# stored credential permanently unrecoverable; leaking it defeats the
# encryption entirely. change_this_to_a_real_generated_fernet_key
CREDENTIAL_VAULT_MASTER_KEY=change_this_to_a_real_generated_fernet_key

# Required when CREDENTIAL_VAULT_KMS_BACKEND=aws_kms (the real production
# recommendation - hardware-backed, access-logged, independently revocable
# from the database). The ARN or key ID of an existing AWS KMS key; the
# process's AWS credentials (not set here - use the normal AWS SDK credential
# chain: an IAM role, ~/.aws/credentials, etc.) need kms:Encrypt/kms:Decrypt
# on it.
AWS_KMS_KEY_ID=

# Seeded competitor retailers (src/market_scraper/retailer_geo.py) are only
# used for tenants operating in the retailer's origin country. List here, comma-
# separated, any seeded retailer YOU have verified ships to your tenants' markets
# (shipping cannot be inferred from a domain). Empty = none assumed international.
RETAILER_INTERNATIONAL_DOMAINS=

# Competitor confidence score weights (spec S20: weights must be configurable).
# Any subset of category/products/proximity/evidence; values are renormalized.
# Empty = defaults (category=0.45, products=0.30, proximity=0.15, evidence=0.10).
COMPETITOR_CONFIDENCE_WEIGHTS=

# ==========================================
# CEOPRO AI - AUTOMATED MARKETING (src/ai/marketing/) - free, no paid API
# ==========================================
# auto = rembg (neural, free) if installed/working, else built-in remover.
# rembg downloads its ~170MB model on first use; set builtin on offline hosts.
MARKETING_BG_REMOVER=auto
# Optional: TTF font for text on images (needs Arabic glyphs for Arabic copy).
MARKETING_FONT_PATH=
MARKETING_MAX_UPLOAD_BYTES=10485760
# Background scene: auto (AI from the free-model pool, offline fallback) | procedural | none
MARKETING_SCENE_PROVIDER=auto
# FREE AI image models (FLUX.1-schnell). Every account you add multiplies the free daily quota;
# comma-separate several. Users never see which provider made an image. All optional:
# with none set, AI Horde (keyless, slow queue) is tried, then the offline renderer.
#   huggingface.co/settings/tokens (free)            -> HUGGINGFACE_API_TOKENS=hf_xxx,hf_yyy
#   dash.cloudflare.com > Workers AI (free tier)     -> CLOUDFLARE_ACCOUNTS=account_id:api_token
#   api.together.ai (free FLUX.1-schnell-Free model) -> TOGETHER_API_KEYS=
#   enter.pollinations.ai (free key)                 -> POLLINATIONS_API_KEYS=
#   aihorde.net/register (free; skips most queue)    -> HORDE_API_KEYS=
HUGGINGFACE_API_TOKENS=
CLOUDFLARE_ACCOUNTS=
TOGETHER_API_KEYS=
POLLINATIONS_API_KEYS=
HORDE_API_KEYS=
MARKETING_AI_DISABLE_HORDE=
MARKETING_AI_HORDE_MAX_WAIT_SECONDS=240

# Self-hosted SearXNG (market discovery without Google)
SEARXNG_SECRET=608598c11e87455e8a08aa8c0720fcbee7ff66b8a5a4f93a521c422c7f8a8fc
SEARXNG_INSTANCE_URL=http://searxng:8080
