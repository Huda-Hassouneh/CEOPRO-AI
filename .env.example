## Server
PORT=5000

## Databases
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME?sslmode=require
AI_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME
NOTIFICATION_WORKER_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME
INGESTION_WORKER_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

## Authentication and payments
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=7d

STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_SECRET_WEBHOOK=replace-with-stripe-webhook-secret
STRIPE_TEST_CLOCK_ID=replace-with-stripe-test-clock-id
STRIPE_USE_TEST_CLOCK=true

SEED_DEV_PASSWORD=replace-with-local-seed-password

## Email
EMAIL_SERVICE_PROVIDER_API_KEY=replace-with-email-provider-api-key
GMAIL_SMTP_APP_PASSWORD=replace-with-gmail-app-password
GMAIL_SMTP_USER=your-address@example.invalid
EMAIL_DELIVERY_PROVIDER=gmail_smtp

## General configuration
CORS_ORIGINS=http://localhost:5173
SUCCESS_SUBSCRIPTION_URL=http://localhost:5173/payment-success
FAILED_SUBSCRIPTION_URL=http://localhost:5173/payment-failed
JSON_BODY_LIMIT=1mb
MAX_UPLOAD_BYTES=10485760
PROMO_FIXED_AMOUNT_CURRENCY=USD
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
AI_SERVICE_USE_MOCKS=false
AI_SERVICE_TIMEOUT_MS=180000

## Dashboard test settings
DASHBOARD_TEST_TENANT_ID=00000000-0000-4000-8000-000000000000
DASHBOARD_TEST_PERIOD_DAYS=30

## Owner bootstrap settings
OWNER_EMAIL=owner@example.invalid
OWNER_PASSWORD=replace-with-owner-password
OWNER_FULL_NAME=CEO PRO Owner
OWNER_COMPANY_NAME=CEO PRO Platform
OWNER_COUNTRY_CODE=JO
OWNER_PRIMARY_CURRENCY=JOD
OWNER_TIMEZONE=Asia/Amman
OWNER_LANGUAGE=en

## Test admin bootstrap settings
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-admin-password
ADMIN_FULL_NAME=Example Admin
ADMIN_TENANT_NAME=Example Company
ADMIN_TENANT_ID=00000000-0000-4000-8000-000000000000
ADMIN_LANGUAGE=en
ADMIN_ID=00000000-0000-4000-8000-000000000000

## Hugging Face / Gradio
HUGGINGFACE_API_URL=https://huggingface.co
HUGGINGFACE_ACCESS_TOKEN=replace-with-huggingface-access-token

model_SPACE=your-org/your-model-space
model_SPACE_URL=https://your-model-space.hf.space
analytics_SPACE=your-org/your-analytics-space
analytics_SPACE_URL=https://your-analytics-space.hf.space