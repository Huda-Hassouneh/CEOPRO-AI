
# CEOPRO AI - Phase 1 Core Infrastructure Environment Configuration
 
# 1. Main Platform Database Connection (PostgreSQL)
POSTGRES_DB=ceopro_platform
POSTGRES_USER=ceopro_admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ceopro_admin:change_this_password@localhost:5432/ceopro_platform

# Password for the restricted, non-superuser ceopro_app role every application
# service should connect as day-to-day (RLS only actually restricts anything
# once the connecting role isn't a superuser - POSTGRES_USER above is the
# bootstrap/superuser role, reserved for running migrations, never for the app).
# Read by scripts/apply_migrations.py to create/update the role; never used to
# construct DATABASE_URL above, which stays on the superuser for migrations.
APP_DB_PASSWORD=change_this_password

# 2. Fast In-Memory Cache and Message Pipeline (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# 3. Object Cloud Storage Connections (MinIO)
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_this_password

# 4. Multi-Tenancy Core Authentication Token
# Required. The application must fail to start if this is not set.
JWT_SECRET=

# ==============================================================================
# CEOPRO AI - HARDENED TELEMETRY AND LOGGING ENVIRONMENT FIELDS (ADDED 2026)
# ==============================================================================
GRAFANA_ADMIN_USER=ceopro_telemetry_supervisor
GRAFANA_ADMIN_PASSWORD=change_this_password

# Optional. Webhook URL the infra watchdog (src/infrastructure/monitoring/watchdog.py)
# posts to when it detects an ingestion-error-rate or stream-backlog threshold breach.
# Degrades gracefully (no alert sent) if left unset.
ALERT_WEBHOOK_URL=
