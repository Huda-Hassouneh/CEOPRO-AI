
# CEOPRO AI - Phase 1 Core Infrastructure Environment Configuration

# 1. Main Platform Database Connection (PostgreSQL)
POSTGRES_DB=ceopro_platform
POSTGRES_USER=ceopro_admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ceopro_admin:change_this_password@localhost:5432/ceopro_platform

# Password for the restricted, non-superuser ceopro_app role every application
# service should connect as day-to-day (RLS only actually restricts anything
# once the connecting role isn't a superuser - POSTGRES_USER above is the
# bootstrap/superuser role, reserved for running migrations, never for the app).
# Read by scripts/apply_migrations.py to create/update the role; never used to
# construct DATABASE_URL above, which stays on the superuser for migrations.
APP_DB_PASSWORD=change_this_password

# 2. Fast In-Memory Cache and Message Pipeline (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Market Scraper Service. Use the restricted ceopro_app role in real runs;
# never point the scraper at the migration/superuser connection above.
SCRAPER_DATABASE_URL=postgresql://ceopro_app:change_this_password@localhost:5432/ceopro_platform
# User/service-principal UUID that is an active tenant member; required by RLS.
SCRAPER_ACTOR_USER_ID=00000000-0000-0000-0000-000000000000
SCRAPER_STREAM_KEY=market.scrape.requested
SCRAPER_DEAD_STREAM_KEY=market.scrape.dead
SCRAPER_MAX_ATTEMPTS=3
SCRAPER_CLAIM_IDLE_MS=300000
SCRAPER_STALE_JOB_MINUTES=30
SCRAPER_MAINTENANCE_INTERVAL_SECONDS=300
SCRAPER_USER_AGENT=CEOPRO-MarketResearchBot/1.0 (+https://github.com/Huda-Hassouneh/CEOPRO-AI)

# 3. Object Cloud Storage Connections (MinIO)
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_this_password

# 4. Multi-Tenancy Core Authentication Token
# Required. The application must fail to start if this is not set.
JWT_SECRET=

# ==============================================================================
# CEOPRO AI - HARDENED TELEMETRY AND LOGGING ENVIRONMENT FIELDS (ADDED 2026)
# ==============================================================================
GRAFANA_ADMIN_USER=ceopro_telemetry_supervisor
GRAFANA_ADMIN_PASSWORD=change_this_password

# Optional. Webhook URL the infra watchdog (src/infrastructure/monitoring/watchdog.py)
# posts to when it detects an ingestion-error-rate or stream-backlog threshold breach.
# Degrades gracefully (no alert sent) if left unset.
ALERT_WEBHOOK_URL=

# ==============================================================================
# CEOPRO AI - RAG CHAT LLM PROVIDER (src/ai/rag/llm_client.py)
# ==============================================================================
# Required for POST /rag/query - without one of the two options below, that
# endpoint fails with a clear LLMError, not a silent wrong answer.

# Option A (default): Groq's hosted, hardware-accelerated API. Free tier
# available - get a key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Caps response length - a real, free latency lever, not just a Groq
# nicety (an uncapped response is what made this matter enough to cap: it's
# what caused a real httpx.ReadTimeout the first time this ran against
# Option B below, whose generation speed is genuinely much slower).
GROQ_MAX_TOKENS=400

# Option B: a local, zero-cost llama.cpp server instead of Groq - full data
# privacy, no external API call at all, real measured ~6 tokens/sec on a
# 4-core/8-thread CPU (see scripts/download_local_llm_model.py and
# docker-compose.yml's llm-local service, profile "local-llm"). Leave blank
# to use Groq (Option A) - set this to switch, nothing else changes.
LOCAL_LLM_BASE_URL=
# Local generation is much slower than Groq's hosted hardware - this is
# sized for that, not a arbitrary bigger number.
LOCAL_LLM_TIMEOUT_SECONDS=90

# ==============================================================================
# CEOPRO AI - MARKET DISCOVERY (src/market_scraper/places_discovery.py,
# social_cross_reference.py) - both optional, free-tier, self-serve
# ==============================================================================
# Google Places API (Text Search) - discovers real local competitor
# businesses from a product/industry + region, before anything else in this
# pipeline has ever heard of them. Self-serve at https://console.cloud.google.com/
# (enable "Places API") - no lengthy app review, unlike Meta's Graph API.
GOOGLE_PLACES_API_KEY=

# Google Custom Search JSON API - queries Google's own search index (built
# by Googlebot, which Instagram's and Facebook's own robots.txt explicitly
# permit on public pages) for a competitor's social presence. Free tier:
# 100 queries/day. Needs both a key (Cloud Console, enable "Custom Search
# API") and a Programmable Search Engine ID configured to search the whole
# web, from https://programmablesearchengine.google.com/
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
