VITE_API_BASE_URL=http://localhost:8000/api
VITE_AUTH_API_MODE=mock
# Development-only visual preview; does not create or persist authentication.
VITE_ENABLE_AUTH_PREVIEW=true
# Development-only onboarding navigation preview; leaves persisted progress unchanged.
VITE_ENABLE_ONBOARDING_PREVIEW=false
VITE_WS_URL=ws://localhost:8000
VITE_STRIPE_KEY=pk_test_your_key_here

# Development-only fictional platform administration. Never enables production access.
VITE_ENABLE_PLATFORM_ADMIN_PREVIEW=false
