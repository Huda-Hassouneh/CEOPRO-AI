# 1. Main Platform Database Connections (PostgreSQL - Ref: Item 1.2)
POSTGRES_DB=ceopro_platform
POSTGRES_USER=ceopro_admin
POSTGRES_PASSWORD=SecurePassword2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ceopro_admin:SecurePassword2026@localhost:5432/ceopro_platform

# 2. Fast In-Memory Cache & Message Pipeline (Redis - Ref: Item 1.3)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# 3. Object Cloud Storage Connections (MinIO - Ref: Item 1.4)
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=MinioSecurePassword2026

# 4. Multi-Tenancy Core Encryption Token
JWT_SECRET=CEOPRO_AI_SECURE_TOKEN_2026_DO_NOT_HARDCODE_IN_PRODUCTION
