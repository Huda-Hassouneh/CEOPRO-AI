# KEEL root environment example. Copy to .env; never commit real secrets.
# See docs/ENVIRONMENT.md for requirement levels, profiles and source locations.
# Optional assignments stay commented: blank numeric values can break Python parsers.
# Root .env is Compose configuration only. KEEL_PYTHON/KEEL_WORKERS are shell overrides.
# Retain the existing Compose project/volume identity; root matches the current local stack.

# ============================================
# APPLICATION, OBSERVABILITY AND TEST TOOLS
# ============================================
# Compose project/volume prefix. Keep root for the existing root stack; changing it selects another volume.
# Local default / profile setting; consumer: Docker Compose built-in project selection
COMPOSE_PROJECT_NAME=root
# Shell-only Python executable override used when creating/selecting the AI virtual environment.
# Optional shell override (not read from root .env); consumer: scripts/keel.mjs:9
# KEEL_PYTHON=
# Comma-separated supervisor child names. Root defaults prices,analysis,discovery; direct supervisor defaults all.
# Optional shell override (not read from root .env); consumer: scripts/keel.mjs:79
# KEEL_WORKERS=prices,analysis,discovery

# ============================================
# DATABASE AND ROLE BOUNDARIES
# ============================================
# Database name (root Compose creates it only on the first volume initialization).
# Local default / profile setting; consumer: docker-compose.yml:6
POSTGRES_DB=KEEL_DEV
# Local administrator password. Changing the env file does not rotate an initialized volume.
# Required for indicated profile; consumer: docker-compose.yml:8
POSTGRES_PASSWORD=REPLACE_WITH_DEV_ADMIN_PASSWORD
# Initial PostgreSQL administrator for local infrastructure; not the runtime application role.
# Local default / profile setting; consumer: docker-compose.yml:7
POSTGRES_USER=keel_migrator
