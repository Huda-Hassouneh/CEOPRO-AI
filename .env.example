
# CEOPRO AI - Phase 1 Core Infrastructure Environment Configuration
 
# 1. Main Platform Database Connection (PostgreSQL)
# ceopro_admin is the bootstrap/superuser role the official Postgres image
# creates from POSTGRES_USER - it should only be used to run schema
# migrations (psql -f init_schema.sql / migrations/*.sql), never as the
# app/consumer's day-to-day DATABASE_URL. Superusers unconditionally bypass
# Row-Level Security, so anything connecting as ceopro_admin has no real
# tenant isolation regardless of the RLS policies in init_schema.sql -
# confirmed empirically (see AI_PROGRESS.md, 2026-08-08 entries).
# migrations/20260808020000_add_app_role_and_force_rls.sql creates a
# non-superuser ceopro_app role for this - set its password out-of-band
# (ALTER ROLE ceopro_app WITH PASSWORD '...', never committed to git) and
# point DATABASE_URL at it for anything that isn't running migrations:
# DATABASE_URL=postgresql://ceopro_app:<password>@localhost:5432/ceopro_platform
POSTGRES_DB=ceopro_platform
POSTGRES_USER=ceopro_admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ceopro_admin:change_this_password@localhost:5432/ceopro_platform

# 2. Fast In-Memory Cache and Message Pipeline (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# 3. Object Cloud Storage Connections (MinIO)
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_this_password

# 4. Multi-Tenancy Core Authentication Token
# Required. The application must fail to start if this is not set.
JWT_SECRET=

# ==============================================================================
# CEOPRO AI - HARDENED TELEMETRY AND LOGGING ENVIRONMENT FIELDS (ADDED 2026)
# ==============================================================================
GRAFANA_ADMIN_USER=ceopro_telemetry_supervisor
GRAFANA_ADMIN_PASSWORD=change_this_password

# Optional. Webhook URL the infra watchdog (src/infrastructure/monitoring/watchdog.py)
# posts to when it detects an ingestion-error-rate or stream-backlog threshold breach.
# Degrades gracefully (no alert sent) if left unset.
ALERT_WEBHOOK_URL=
