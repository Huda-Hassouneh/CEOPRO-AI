# ============================================
# DATABASE AND ROLE BOUNDARIES
# ============================================
# Separate administrator URL for guarded DEV/TEST migrations/bootstrap; never the running API account.
# Required for indicated profile; consumer: backend/prisma/bootstrap/owner.ts:9
BOOTSTRAP_DATABASE_URL=postgresql://keel_migrator:REPLACE_WITH_DEV_ADMIN_PASSWORD@127.0.0.1:5433/KEEL_DEV
# Restricted ceopro_app connection for canonical runtime queries; migrations use a separate administrator.
# Required for indicated profile; consumer: backend/prisma/bootstrap/features.ts:13
DATABASE_URL=postgresql://ceopro_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:5433/KEEL_DEV
# Dedicated ceopro_ingestion_worker connection for staged canonical imports.
# Required for indicated profile; consumer: backend/src/config/ingestion-worker-database.ts:6
INGESTION_WORKER_DATABASE_URL=postgresql://ceopro_ingestion_worker:REPLACE_WITH_INGESTION_PASSWORD@127.0.0.1:5433/KEEL_DEV
# Dedicated ceopro_market_dispatcher connection for market scheduling AND store synchronization scheduling.
# Required for indicated profile; consumer: backend/src/config/market-dispatcher-database.ts:4
MARKET_DISPATCHER_DATABASE_URL=postgresql://ceopro_market_dispatcher:REPLACE_WITH_DISPATCHER_PASSWORD@127.0.0.1:5433/KEEL_DEV
# Dedicated ceopro_notification_worker connection for both notification workers.
# Required for indicated profile; consumer: backend/src/config/notification-worker-database.ts:6
NOTIFICATION_WORKER_DATABASE_URL=postgresql://ceopro_notification_worker:REPLACE_WITH_NOTIFICATION_PASSWORD@127.0.0.1:5433/KEEL_DEV
# Database name (root Compose creates it only on the first volume initialization).
# Optional; required when consumer enabled; consumer: backend/docker-compose.yaml:18
# POSTGRES_DB=
# Local administrator password. Changing the env file does not rotate an initialized volume.
# Optional; required when consumer enabled; consumer: backend/docker-compose.yaml:9
# POSTGRES_PASSWORD=
# Initial PostgreSQL administrator for local infrastructure; not the runtime application role.
# Optional; required when consumer enabled; consumer: backend/docker-compose.yaml:18
# POSTGRES_USER=
# Restricted collector database connection; no administrative privilege bypass.
# Optional forwarded Python worker setting; consumer: scripts/keel.mjs:environment (forwarded from ai/.env or set in backend/.env)
# SCRAPER_DATABASE_URL=
# Scraper db pool max size setting for the referenced consumer; leave unset unless configuring that workflow.
# Optional forwarded Python worker setting; consumer: scripts/keel.mjs:environment (forwarded from ai/.env or set in backend/.env)
# SCRAPER_DB_POOL_MAX_SIZE=
# Scraper db pool min size setting for the referenced consumer; leave unset unless configuring that workflow.
# Optional forwarded Python worker setting; consumer: scripts/keel.mjs:environment (forwarded from ai/.env or set in backend/.env)
# SCRAPER_DB_POOL_MIN_SIZE=

