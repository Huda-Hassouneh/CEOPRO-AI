
# KEEL - Phase 1 Core Infrastructure Environment Configuration
#
# The source of truth for which settings exist, which are required and where
# each value comes from is backend/KEYS_AND_ACCOUNTS_NEEDED.md. Check a real
# environment against it with `./keel check` (names only, never values).
#
# REQUIRED: JWT_SECRET, DATABASE_URL, APP_DB_PASSWORD, POSTGRES_PASSWORD (local
# Docker), REDIS_URL or REDIS_HOST, CREDENTIAL_VAULT_MASTER_KEY (a Fernet key;
# ./keel setup generates one), and where deployed FRONTEND_BASE_URL,
# APP_BASE_URL, CORS_ALLOWED_ORIGINS, SMTP_*, MINIO_*.
# Everything else is an optional integration and stays off while blank.
# A paid provider stays refused even with its key until its price is
# recorded (python -m scripts.billing_admin set-price).
#
# Names and safe local defaults only - never put a real API key, token or
# password in this file or a copy that could be committed. API credentials
# (GROQ_API_KEY, HUGGINGFACE_API_TOKEN, TAVILY_API_KEY, ...) come from
# Codespaces secrets, GitHub Actions secrets or the host's secret settings:
# leave them empty here and ./keel keeps the value the environment provides.
# Which are required, which are optional and where each is set:
# docs/SECRETS.md.

# 1. Main Platform Database Connection (PostgreSQL)
POSTGRES_DB=ceopro_platform
POSTGRES_USER=ceopro_admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ceopro_admin:change_this_password@postgres:5432/ceopro_platform

# Password for the restricted, non-superuser ceopro_app role every application
# service should connect as day-to-day (RLS only actually restricts anything
# once the connecting role isn't a superuser - POSTGRES_USER above is the
# bootstrap/superuser role, reserved for running migrations, never for the app).
# Read by scripts/apply_migrations.py to create/update the role; never used to
# construct DATABASE_URL above, which stays on the superuser for migrations.
APP_DB_PASSWORD=change_this_password

# src/ai/db.py pools ceopro_app connections (src/infrastructure/db_pool.py)
# instead of opening a fresh one per request - RLS context is set via
# SET LOCAL per transaction, which Postgres guarantees cannot survive a
# connection-reuse boundary, so pooling here never risks a cross-tenant
# leak even if reused across different tenants back to back. minconn are
# opened eagerly on first use; maxconn bounds this process's total.
APP_DB_POOL_MIN_SIZE=1
APP_DB_POOL_MAX_SIZE=10
# How long a request waits for a free pooled connection before the API
# answers 503 (busy) - requests queue in turn instead of failing at once.
APP_DB_POOL_WAIT_SECONDS=10

# User/service-principal UUID that is an active tenant member, required by RLS -
# used by src/ai/forecasting/consumer.py (and any other ai/ background worker
# acting on a tenant's behalf with no live end user behind the request) via
# src/ai/db.py::app_role_connection(). Same role SCRAPER_ACTOR_USER_ID plays
# for the market_scraper service below.
AI_SERVICE_ACTOR_USER_ID=00000000-0000-0000-0000-000000000000

# Attempt-tracking/dead-letter/reclaim tuning for src/ai/forecasting/
# consumer.py - same contract as SCRAPER_MAX_ATTEMPTS/SCRAPER_DEAD_STREAM_KEY
# below. A forecast request that keeps failing (a deleted product_id, a
# malformed payload) is retried this many times before moving to the dead
# stream instead of sitting stuck in the consumer group's PEL forever.
AI_FORECAST_DEAD_STREAM_KEY=ceopro:stream:demand_forecast_requested:dead
AI_FORECAST_MAX_ATTEMPTS=3
AI_FORECAST_CLAIM_IDLE_MS=300000

# 2. Fast In-Memory Cache and Message Pipeline (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Market Scraper Service. Use the restricted ceopro_app role in real runs;
# never point the scraper at the migration/superuser connection above.
SCRAPER_DATABASE_URL=postgresql://ceopro_app:change_this_password@localhost:5432/ceopro_platform
# User/service-principal UUID that is an active tenant member; required by RLS.
SCRAPER_ACTOR_USER_ID=00000000-0000-0000-0000-000000000000
# Same pooling mechanism/safety as APP_DB_POOL_MIN_SIZE/MAX_SIZE above, applied
# to this service's own separate connection pool (a different process, so it
# never shares a pool with src/ai/db.py's).
SCRAPER_DB_POOL_MIN_SIZE=1
SCRAPER_DB_POOL_MAX_SIZE=10
SCRAPER_STREAM_KEY=market.scrape.requested
SCRAPER_DEAD_STREAM_KEY=market.scrape.dead
SCRAPER_MAX_ATTEMPTS=3
SCRAPER_CLAIM_IDLE_MS=300000
SCRAPER_STALE_JOB_MINUTES=30
SCRAPER_MAINTENANCE_INTERVAL_SECONDS=300
SCRAPER_USER_AGENT="KEEL-MarketResearchBot/1.0 (+https://github.com/Huda-Hassouneh/360-Radar)"

# Attempt-tracking/dead-letter/reclaim tuning for
# src/market_scraper/analysis_worker.py - same contract as
# SCRAPER_MAX_ATTEMPTS/SCRAPER_DEAD_STREAM_KEY above, for the separate
# market.analysis.requested stream (post-scrape sentiment/score/RAG-summary
# refresh) instead of market.scrape.requested.
ANALYSIS_DEAD_STREAM_KEY=market.analysis.dead
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_CLAIM_IDLE_MS=300000

# The automatic upload -> discovery trigger (production-hardening audit
# fix): src/ai/main.py's POST /extraction/upload publishes
# DISCOVERY_STREAM_KEY right after real new products are persisted;
# src/market_scraper/discovery_worker.py consumes it and runs full
# competitor discovery for that tenant. Same attempt-tracking/dead-letter
# contract as SCRAPER_MAX_ATTEMPTS/SCRAPER_DEAD_STREAM_KEY above.
DISCOVERY_STREAM_KEY=market.discovery.requested
DISCOVERY_DEAD_STREAM_KEY=market.discovery.dead
DISCOVERY_MAX_ATTEMPTS=3
DISCOVERY_CLAIM_IDLE_MS=300000

# src/market_scraper/connector_worker.py - the scheduled process that
# actually runs both connector types (connector_sync.py's direct-database
# connector, api_connector_sync.py's generic POS/ERP/API connector) on a
# schedule; a tenant registers one via POST /onboarding/connect/database
# or /onboarding/connect/api. Not event-driven (no stream key here) -
# a client's own system doesn't notify KEEL when it changes, so this
# polls on an interval instead; each individual source's own
# sync_frequency_minutes (set at registration) still governs how often
# THAT source is actually synced.
CONNECTOR_WORKER_POLL_INTERVAL_SECONDS=300

# 3. Object Cloud Storage Connections (MinIO)
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_this_password

# 4. Multi-Tenancy Core Authentication Token
# Required. The application must fail to start if this is not set.
JWT_SECRET=

# How long one access token stays valid, in minutes. The app renews it while
# someone is using it (POST /auth/refresh), so this is the idle timeout.
JWT_EXPIRE_MINUTES=120
# Longest a sign-in can be kept alive by automatic renewal (hours).
SESSION_MAX_HOURS=168

# How long a password-reset code, an email-verification code, and a team-
# invitation link stay valid, in minutes (core/security.py). Codes are
# short-lived (a leaked, long-lived reset code is a real account-takeover
# risk); invitations are long-lived (realistically sits in an inbox for days).
PASSWORD_RESET_CODE_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=60
# Whether people must confirm their email address (the code sent at sign-up)
# before using the app: auto = only once email delivery (SMTP_HOST) is
# configured, so no environment locks people out; true / false force it.
# Accepting a team invitation or resetting a password also confirms it.
REQUIRE_EMAIL_VERIFICATION=auto
TEAM_INVITATION_EXPIRE_MINUTES=20160

# Outbound transactional email (core/notifications.py) - password-reset/
# email-verification codes and team-invitation links. Works with any
# provider that exposes an SMTP endpoint (Brevo, Resend, SendGrid, AWS SES,
# Mailgun, ...) - no vendor-specific SDK required. When SMTP_HOST is unset
# nothing is sent and the log says so (masked recipient, no code).
# Local development only: EMAIL_LOG_UNSENT_BODIES=true also logs the unsent
# email's body (the real code/link) so flows can be finished from the
# server log. Never set it where real accounts exist.
EMAIL_LOG_UNSENT_BODIES=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@keel.ai

# The real frontend origin a team-invitation email links back to
# (core/notifications.py::send_team_invitation_email() builds
# {FRONTEND_BASE_URL}/invitation/{token}). Defaults to the Vite dev
# server's own default port - a real deployed frontend origin must be set
# explicitly here for a production invitation link to resolve correctly.
FRONTEND_BASE_URL=http://localhost:5173
# The same frontend address, used by Billing for Stripe's return pages
# (checkout success/cancel, the billing portal). Required where deployed.
APP_BASE_URL=http://localhost:5173

# Alert summary emails (notification_digest.py): sent to people who chose a
# daily or weekly summary in Settings -> Notifications, at this hour in the
# company's time zone (weekly: Mondays), only when there is something new.
# Runs inside the API process; set to false to turn it off.
NOTIFICATION_DIGEST_ENABLED=true
NOTIFICATION_DIGEST_HOUR=7

# Real browser origins allowed to call this API (CORSMiddleware, main.py) -
# comma-separated, no trailing slash on any entry. Without this, every
# browser request from the frontend fails at the CORS preflight before
# this service's own auth/logic ever runs. Defaults (when unset) to the
# Vite dev server's own default port only - a real deployed frontend
# origin must be set explicitly here, never guessed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# KEEL - HARDENED TELEMETRY AND LOGGING ENVIRONMENT FIELDS (ADDED 2026)
# ==============================================================================
GRAFANA_ADMIN_USER=ceopro_telemetry_supervisor
GRAFANA_ADMIN_PASSWORD=change_this_password

# Optional. Webhook URL the infra watchdog (src/infrastructure/monitoring/watchdog.py)
# posts to when it detects an ingestion-error-rate or stream-backlog threshold breach.
# Degrades gracefully (no alert sent) if left unset.
ALERT_WEBHOOK_URL=

# ==============================================================================
# KEEL - RAG CHAT LLM PROVIDER (src/ai/rag/llm_client.py)
# ==============================================================================
# Required for POST /rag/query - without one of the two options below, that
# endpoint fails with a clear LLMError, not a silent wrong answer.

# Option A (default): Groq's hosted, hardware-accelerated API. Free tier
# available - get a key at https://console.groq.com/ (a secret: leave empty
# here, see docs/SECRETS.md)
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-20b
# Caps response length - a real, free latency lever, not just a Groq
# nicety (an uncapped response is what made this matter enough to cap: it's
# what caused a real httpx.ReadTimeout the first time this ran against
# Option B below, whose generation speed is genuinely much slower).
# Must leave headroom for gpt-oss-20b's hidden reasoning, which is billed out of
# this same budget: at 400, real calls returned completion_tokens pinned at the
# cap and an EMPTY answer (see llm_client.DEFAULT_MAX_TOKENS and
# test_default_max_tokens_leaves_real_headroom_for_a_reasoning_model).
GROQ_MAX_TOKENS=1500

# Assistant retrieval models (measured peak memory of the ai process, see
# scripts/rag_runtime_check.py): torch = sentence-transformers embedder +
# cross-encoder re-ranker, ~2 GB; onnx = the same embedder's ONNX export, no
# torch, ~830 MB with the re-ranker off; static = a static multilingual model
# (static-similarity-mrl-multilingual-v1, Arabic included), ~350 MB, the 512 MB
# setting; none = keyword search only, ~300 MB.
RAG_EMBEDDING_BACKEND=torch
RAG_RERANKER_ENABLED=true
# The embedding and re-ranking models are public and need no token. This
# stops the Hugging Face library from attaching an HF_TOKEN it finds in the
# environment (the app itself never reads HF_TOKEN): an expired or revoked
# one would make every model download fail with 401.
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
# With onnx: which export of the model to run (8-bit by default; onnx/model.onnx
# is full precision, ~1.2 GB) and how many CPU threads it may use.
RAG_EMBEDDING_ONNX_FILE=onnx/model_quint8_avx2.onnx
RAG_EMBEDDING_ONNX_THREADS=1

# Retry jitter (production-hardening audit fix) - each retry's linear
# backoff is lengthened by a random 0%-N% (never shortened), spreading
# retries out instead of many concurrent requests retrying in lockstep at
# the exact same intervals during a real provider-wide outage/429 event.
GROQ_RETRY_JITTER_FRACTION=0.5

# Circuit breaker (production-hardening audit fix) - after this many
# consecutive request-level failures (each already exhausted its own
# retries), a new /rag/query call fails fast instead of repeating the
# full retry sequence against a provider that's already known to be down -
# real protection against exhausting the FastAPI thread pool under a
# sustained outage. In-process only, resets on any successful call.
GROQ_CIRCUIT_BREAKER_THRESHOLD=5
GROQ_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Option B: a local, zero-cost llama.cpp server instead of Groq - full data
# privacy, no external API call at all, real measured ~6 tokens/sec on a
# 4-core/8-thread CPU (see scripts/download_local_llm_model.py and
# docker-compose.yml's llm-local service, profile "local-llm"). Leave blank
# to use Groq (Option A) - set this to switch, nothing else changes.
LOCAL_LLM_BASE_URL=
# Local generation is much slower than Groq's hosted hardware - this is
# sized for that, not a arbitrary bigger number.
LOCAL_LLM_TIMEOUT_SECONDS=90

# Option C: a paid subscription vendor (OpenAI, Together AI, Azure OpenAI,
# Fireworks, or any other OpenAI-schema-compatible provider) - the
# flexible placeholder for swapping Groq out later without a rewrite.
# Takes priority over both Option A and Option B when set. Leave blank to
# keep using Groq (or Option B) - this is a config slot, not a live
# integration; no vendor is provisioned here yet.
PAID_LLM_BASE_URL=
PAID_LLM_API_KEY=
# Optional - defaults to GROQ_MODEL's value if left blank.
PAID_LLM_MODEL=
PAID_LLM_TIMEOUT_SECONDS=20

# Option D: Hugging Face Inference Providers (router.huggingface.co, an
# OpenAI-compatible router in front of third-party providers). Off while
# HUGGINGFACE_LLM_MODEL is empty - HUGGINGFACE_API_TOKEN alone (below, also
# used for marketing images) doesn't change the assistant's provider. Set it
# to a chat model id, e.g. openai/gpt-oss-20b (or openai/gpt-oss-20b:groq to
# pin the provider). Takes priority over Options A and B; Option C still wins.
# Questions and the company passages retrieved for them go to Hugging Face
# and that provider. Free accounts get a small monthly credit; requests then
# fail (no charge) unless billing is set up on the HF account.
HUGGINGFACE_LLM_MODEL=
HUGGINGFACE_LLM_TIMEOUT_SECONDS=30

# ==============================================================================
# KEEL - AUTOMATED MARKETING: AI IMAGE GENERATION
# (src/ai/marketing/image_generation.py) - optional. Unset by default: real
# AI image generation stays off until one is explicitly chosen. See
# backend/MARKETING_AI_CAPABILITIES.md for the full provider investigation
# (costs, GPU/RAM/credit-card requirements, why local/on-server generation
# is not viable on this platform's free-tier hosting) and for why video
# generation is not implemented at all.
# ==============================================================================
# Providers to try, in order (comma-separated): cloudflare, huggingface,
# pollinations. Blank ("auto") = every keyed provider below, then the keyless
# Pollinations endpoint unless MARKETING_IMAGE_KEYLESS=false. "none" turns
# images off. (The older single MARKETING_IMAGE_PROVIDER still works.)
# Cloudflare and Hugging Face are paid per image and stay refused until their
# price is recorded (scripts.billing_admin set-price --budget ai
# --operation image_generation --unit image); Pollinations is free.
MARKETING_IMAGE_PROVIDERS=
MARKETING_IMAGE_KEYLESS=true

# Option "cloudflare": Workers AI (free daily allowance). Two settings, both
# needed: the account id and an API token with the Workers AI permission
# (dash.cloudflare.com -> AI -> Workers AI -> Use REST API).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Option "pollinations": image.pollinations.ai - keyless, free, no account,
# no credit card. No credential needed; only the two knobs below are
# optional overrides.
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
MARKETING_IMAGE_WIDTH=1024
MARKETING_IMAGE_HEIGHT=1024

# Option "huggingface": Hugging Face's hosted Inference API. Needs a free
# HuggingFace account (no credit card to create one) and an access token
# from https://huggingface.co/settings/tokens. Which models stay on HF's
# free serverless tier changes over time - verify the configured model is
# still free before relying on it in production.
# The same token serves Option D above. Least privilege: a fine-grained
# token with only "Make calls to Inference Providers" ticked (no repository
# read or write access) - a secret, never written here.
HUGGINGFACE_API_TOKEN=
# --- More FREE accounts = more free images/day. Comma-separate several of each; they are
# rotated and failed over automatically and users never see which one made an image. ---
#   huggingface.co/settings/tokens (free)           HUGGINGFACE_API_TOKENS=hf_a,hf_b
#   dash.cloudflare.com > AI > Workers AI (free)    CLOUDFLARE_ACCOUNTS=account_id:token,account_id:token
#   api.together.ai (free FLUX.1-schnell-Free)      TOGETHER_API_KEYS=
#   aihorde.net/register (free; far shorter queue)  HORDE_API_KEYS=
#   enter.pollinations.ai (free key)                POLLINATIONS_API_KEYS=
# With none set, only the keyless AI Horde / Pollinations fallbacks run: no account needed, but
# its queue can take minutes and it can throttle. Keyless Pollinations is never used (it watermarks images).
HUGGINGFACE_API_TOKENS=
CLOUDFLARE_ACCOUNTS=
TOGETHER_API_KEYS=
HORDE_API_KEYS=
POLLINATIONS_API_KEYS=
MARKETING_AI_HORDE_MAX_WAIT_SECONDS=240
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Shared across both providers.
MARKETING_IMAGE_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# Background removal (src/ai/marketing/background_removal.py) - free, open-
# source, no API key, no credit card. Set to "rembg" to enable.
#
# NOT SAFE ON RENDER'S FREE PLAN TODAY - leave unset there. Measured in this
# repo's own dev sandbox: rembg's own import + smallest model + one real
# inference call peaks at ~520-540MB RSS in an otherwise-bare process,
# already at/over Render's free 512MB total, before this service's own
# baseline (torch/transformers/sentence-transformers/faiss) is added on
# top. See backend/MARKETING_AI_CAPABILITIES.md section 1a for the full
# investigation and the real paths to enabling it later (a paid Render
# plan, or a separate smaller process/service).
MARKETING_BACKGROUND_REMOVAL_PROVIDER=

# Optional - defaults to the smallest model rembg ships (u2netp, 4.7MB).
# Larger models (u2net, isnet-general-use - both 176MB) are more accurate
# but cost meaningfully more RAM; only relevant once background removal
# is actually enabled somewhere with real RAM headroom.
REMBG_MODEL=u2netp

# ==============================================================================
# KEEL - MARKET DISCOVERY (src/market_scraper/places_discovery.py,
# social_cross_reference.py) - both optional, free-tier, self-serve
# ==============================================================================
# Google Places API (Text Search) - discovers real local competitor
# businesses from a product/industry + region, before anything else in this
# pipeline has ever heard of them. Self-serve at https://console.cloud.google.com/
# (enable "Places API") - no lengthy app review, unlike Meta's Graph API.
GOOGLE_PLACES_API_KEY=

# Apify's Google Maps scraper (actor compass~crawler-google-places) as one
# more competitor discovery source - token from https://console.apify.com/
# (Settings > API & Integrations). Each discovery run is billed to that
# Apify account; APIFY_MAX_PLACES_PER_SEARCH caps places per search phrase.
APIFY_API_TOKEN=
APIFY_MAX_PLACES_PER_SEARCH=40

# Web search for the assistant's research and competitor discovery goes
# through src/market_scraper/web_search.py. Providers are tried in this
# order; each is skipped until its key/URL below is set.
#   google_cse - closed to new customers; stops serving on 2027-01-01
#   brave      - BRAVE_SEARCH_API_KEY: $5 monthly credit (~1,000 searches), card on file
#   tavily     - TAVILY_API_KEY: 1,000 free credits/month, no card
#   searxng    - SEARXNG_INSTANCE_URL: self-hosted, no key
WEB_SEARCH_PROVIDERS=google_cse,brave,tavily,searxng
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Overture Maps places - keyless open data (Overture Maps Foundation,
# CDLA-Permissive-2.0), read from its public bucket; needs pyarrow
# (requirements.txt) and outbound HTTPS to overturemaps-us-west-2.s3.amazonaws.com.
# File indexes are cached in OVERTURE_CACHE_DIR (default ~/.cache/keel/overture).
# OVERTURE_RELEASE=2026-09-23.1      # pin a release (default: newest)
# OVERTURE_CACHE_DIR=
# DISCOVERY_DISABLE_OVERTURE=false

# Competitor websites: how many are read per scan (most relevant first), in
# parallel, pages per site, and the pause between a site's pages. Pages that
# only show content after JavaScript are rendered when Playwright and a
# Chromium are installed (DISCOVERY_RENDER_JS=false turns that off).
# DISCOVERY_MAX_RESULTS=1000
# OVERTURE_MAX_CANDIDATES=1500
# DISCOVERY_INTEL_MAX_SITES=60
# DISCOVERY_INTEL_WORKERS=8
# DISCOVERY_INTEL_MAX_PAGES=8
# DISCOVERY_INTEL_PAGE_DELAY_SECONDS=0.4
# DISCOVERY_RENDER_JS=auto
# KEEL_CHROMIUM_PATH=/usr/bin/google-chrome
# Specialty words, product names in the other language and English category
# words come from the configured AI model; false = without them.
# DISCOVERY_AI_HINTS=true

# Google Custom Search JSON API (existing accounts only, until 2027-01-01) - queries Google's own search index (built
# by Googlebot, which Instagram's and Facebook's own robots.txt explicitly
# permit on public pages) for a competitor's social presence. Free tier:
# 100 queries/day. Needs both a key (Cloud Console, enable "Custom Search
# API") and a Programmable Search Engine ID configured to search the whole
# web, from https://programmablesearchengine.google.com/
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# SearXNG fallback (src/market_scraper/searxng_discovery.py) - used when
# Google Custom Search is unconfigured, over its daily budget, or fails.
# Point this at a SearXNG instance with its JSON API enabled (self-hosted,
# or a public instance that has explicitly opted in to serving JSON).
# Leave unset when running via docker-compose.yml's own `searxng` service
# (docker compose up -d searxng market-discovery-worker) - the worker's own
# compose environment already defaults this to http://searxng:8080, so no
# .env edit is needed for that setup; only set this to override it (a
# different instance, or a bare `python -m ...` run outside docker compose,
# which would need e.g. http://localhost:8080 instead).
SEARXNG_INSTANCE_URL=
# Signing secret of the self-hosted SearXNG container (generate: python -c "import secrets; print(secrets.token_hex(32))").
# Real value goes in backend/.env only - never commit it.
SEARXNG_SECRET=

# Assistant public research (src/ai/research/): when a question needs
# evidence the company's own records can't give (customer preferences,
# products and sellers, the market, regulations, customs and trade), the
# assistant searches through the provider above, reads the result pages
# themselves and cites them. Without a configured provider it says so and
# answers from the company's own data. Budgets are counted per server and
# per company per day (Tavily's free tier is ~33 searches a day).
RESEARCH_DAILY_SEARCH_LIMIT=30
RESEARCH_TENANT_DAILY_SEARCH_LIMIT=12
# Pages read per question, and how long a read page is kept as a cache.
RESEARCH_MAX_PAGES=4
RESEARCH_PAGE_RETENTION_DAYS=30
# Output budget of one assistant answer, in tokens (a provider's per-request
# ceiling counts prompt + this; the assistant retries with a compact prompt
# when the provider refuses the size).
ADVISOR_MAX_TOKENS=1500

# ==============================================================================
# KEEL - CREDENTIAL VAULT ENCRYPTION (src/market_scraper/credential_vault.py)
# ==============================================================================
# Every data_sources.connection_credentials_vault value (Apify tokens, PA-API
# keys, a future client DB/ERP connector's credentials) is envelope-encrypted,
# never stored in plaintext. CREDENTIAL_VAULT_KMS_BACKEND selects how the
# per-credential encryption key itself gets protected - "local" (default) or
# "aws_kms".
CREDENTIAL_VAULT_KMS_BACKEND=local

# Required when CREDENTIAL_VAULT_KMS_BACKEND=local (the default - no cloud
# account needed for dev/self-hosted use). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Treat this exactly like a database root password: losing it makes every
# stored credential permanently unrecoverable; leaking it defeats the
# encryption entirely. Must be a Fernet key (44 characters, ends in "="); a
# hex string from `openssl rand -hex 32` is rejected. ./keel setup fills in
# a new one when this is blank. Never change a key companies' credentials
# are stored under without rotating (python -m scripts.vault_key).
CREDENTIAL_VAULT_MASTER_KEY=

# Only while rotating: the previous master key(s), comma-separated, so stored
# credentials stay readable until `python -m scripts.vault_key rewrap` has
# moved them to the new key. Remove afterwards.
CREDENTIAL_VAULT_PREVIOUS_KEYS=

# Required when CREDENTIAL_VAULT_KMS_BACKEND=aws_kms (the real production
# recommendation - hardware-backed, access-logged, independently revocable
# from the database). The ARN or key ID of an existing AWS KMS key; the
# process's AWS credentials (not set here - use the normal AWS SDK credential
# chain: an IAM role, ~/.aws/credentials, etc.) need kms:Encrypt/kms:Decrypt
# on it.
AWS_KMS_KEY_ID=

# Application log level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Subscription allowances (src/ai/core/usage.py). Plans and their limits live in
# the usage_plans / usage_plan_limits tables; a company is put on a plan by a row
# in tenant_plan_assignments (operator or billing service). Companies without a
# row use DEFAULT_PLAN_KEY. These are separate from the technical upload limits.
DEFAULT_PLAN_KEY=growth
# A company with no plan (its free trial was refused - one per company and
# per person - or never started) has no access: "none". "default" gives it
# DEFAULT_PLAN_KEY instead; only for single-company installs, never staging
# or production.
UNASSIGNED_PLAN_ACCESS=none
# Billing upkeep (src/ai/billing/maintenance.py): charges credit reservations
# whose call never finished (a crashed process), every N seconds.
BILLING_MAINTENANCE_ENABLED=true
BILLING_MAINTENANCE_SECONDS=300
# Data/AI Credit prices, spending caps and kill switches are NOT settings:
# they live in the database and are changed with scripts/billing_admin.py
# (audited). See docs/SUBSCRIPTIONS_AND_CREDITS.md.
# Fairness cap: assistant questions per company per minute, so one company can't
# use up the shared AI provider's per-minute capacity for everyone else.
AI_REQUESTS_PER_MINUTE_PER_COMPANY=8

# General API rate limit (core/rate_limit.py): requests per minute per
# signed-in company and per anonymous client address; 429 + Retry-After
# beyond that. Behind a proxy that appends the client address to
# X-Forwarded-For (Render), set API_TRUST_FORWARDED_FOR=true.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_COMPANY_PER_MINUTE=600
API_RATE_LIMIT_PER_IP_PER_MINUTE=120
API_TRUST_FORWARDED_FOR=false

# --- Payments (Stripe) ---
# Without these the Billing page shows plans and usage but online checkout is
# off. Use test keys (sk_test_...) until you are ready to take real payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true = let Stripe calculate tax at checkout (requires Stripe Tax).
STRIPE_AUTOMATIC_TAX=false

# Error tracking (Sentry) - optional; leave empty to keep it off. Used by the
# API and every background worker (src/infrastructure/monitoring/error_tracking.py).
# Request bodies, cookies, credentials, query strings and user details are
# never sent. The browser app uses its own VITE_SENTRY_DSN (frontend/.env).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Seeded competitor retailers (src/market_scraper/retailer_geo.py) are only
# used for tenants operating in the retailer's origin country. List here, comma-
# separated, any seeded retailer YOU have verified ships to your tenants' markets
# (shipping cannot be inferred from a domain). Empty = none assumed international.
RETAILER_INTERNATIONAL_DOMAINS=

# Competitor confidence score weights (spec S20: weights must be configurable).
# Any subset of category/products/proximity/evidence; values are renormalized.
# Empty = defaults (category=0.45, products=0.30, proximity=0.15, evidence=0.10).
COMPETITOR_CONFIDENCE_WEIGHTS=

# ==============================================================================
# CEOPRO AI - COMPETITOR ENRICHMENT (src/market_scraper/competitor_enrichment.py)
# Profile (Google Places), social links and Google reviews, run after every
# discovery pass, on the hourly sweep, and on the per-competitor Retry
# (POST /competitors/{id}/enrich). A missing/rejected key is shown on the
# competitor as NO_CREDENTIALS / CREDENTIALS_REJECTED, not hidden.
# ==============================================================================
# Operator's recorded approval to STORE Google Places reviews (Google's terms
# govern stored Places content). Name the document/ticket that approved it.
# Empty = the REVIEWS facet stays BLOCKED (PLATFORM_APPROVAL_MISSING).
PLACES_TERMS_APPROVAL_REFERENCE=
# Max competitors enriched per discovery run (bounds paid Places calls).
ENRICHMENT_MAX_PER_RUN=50
# Cap for the owner's "retry all failed" batch.
ENRICHMENT_MAX_BULK=200
# A transient failure (provider error, quota, unreachable site) is retried by a later sweep after this many hours.
ENRICHMENT_RETRY_AFTER_HOURS=6
# Minimum seconds between two manual retries of the same facet.
ENRICHMENT_MIN_RETRY_SECONDS=30
ENRICHMENT_STREAM_KEY=market.enrichment.requested
ENRICHMENT_DEAD_STREAM_KEY=market.enrichment.dead
ENRICHMENT_MAX_ATTEMPTS=3
ENRICHMENT_CLAIM_IDLE_MS=300000
# How often the worker looks for never-attempted / due-for-retry competitors.
ENRICHMENT_SWEEP_INTERVAL_SECONDS=3600
# An identical queued job (same tenant+competitor+mode) is ignored for this long or until it finishes.
ENRICHMENT_DEDUPE_SECONDS=600

# ==============================================================================
# CEOPRO AI - MARKET REFERENCE PRICES (src/market_scraper/price_lookup/)
# For products with no competitor price: open price databases, sellers' public
# product pages found by web search, and (opt in) Google Shopping via SerpAPI.
# POST /pricing/market-coverage/fill runs it on demand.
# ==============================================================================
# Sources tried in this order, stopping at the first that finds an acceptable price.
PRICE_LOOKUP_PROVIDERS=open_prices,web_offers,serpapi_shopping
# Paid Google Shopping lookup (https://serpapi.com). Empty = that source is skipped.
SERPAPI_API_KEY=
# Products looked up per run, and days before a product with nothing found is searched again.
PRICE_LOOKUP_MAX_PER_RUN=20
PRICE_LOOKUP_RETRY_DAYS=7
# true = keep consulting every source for more evidence instead of stopping at the first hit.
PRICE_LOOKUP_ALL_PROVIDERS=false
# true = also run the lookup after every discovery pass (spends search quota).
PRICE_LOOKUP_AUTO=false
# Open Prices: ignore shelf prices older than this many days.
PRICE_LOOKUP_MAX_AGE_DAYS=365

# ==============================================================================
# CEOPRO AI - MORE COMPETITOR SOURCES: news, comments and likes
# ==============================================================================
# News: a competitor's own website feed (no key) plus the news mode of whichever web-search
# provider is configured (BRAVE_SEARCH_API_KEY / TAVILY_API_KEY / SEARXNG_INSTANCE_URL). Google News RSS
# is not used (its terms allow personal use only).
# Ignore news older than this many days.
NEWS_MAX_AGE_DAYS=180
# YouTube Data API v3 key (https://console.cloud.google.com, enable "YouTube Data API v3"; free quota
# 10,000 units/day, a search costs 100). Reads public comments, with likes, on videos naming the competitor.
YOUTUBE_API_KEY=
# Apify: with APIFY_API_TOKEN (set above, for competitor discovery) a Google Maps listing's reviews are
# also read deeper than the Places API's 5, with likes and the owner's replies. Billed to that Apify
# account. (APIFY_TOKEN, the older name, still works.)
APIFY_REVIEWS_MAX=100
# Operator's recorded approval to STORE public comments/reviews from YouTube and the Apify Google
# source (name the document/ticket). Empty = YouTube comments stay BLOCKED. Google reviews use
# PLACES_TERMS_APPROVAL_REFERENCE above. YouTube comments are kept 30 days (its API terms).
EXTERNAL_COMMENTS_APPROVAL_REFERENCE=

