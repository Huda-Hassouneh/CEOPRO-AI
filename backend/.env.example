# ============================================
# STORE INTEGRATIONS
# ============================================
# Server app client identifier from Shopify Dev Dashboard; merchants authorize that app.
# Optional; required when consumer enabled; consumer: backend/src/modules/dataconnection/store/shopify/domain.ts:14
# SHOPIFY_CLIENT_ID=
# Server app secret for OAuth exchange/webhook HMAC; never browser configuration.
# Optional; required when consumer enabled; consumer: backend/src/modules/dataconnection/store/shopify/domain.ts:14
# SHOPIFY_CLIENT_SECRET=
# Exact public HTTPS backend /integrations/shopify/callback URL whitelisted in Shopify.
# Optional; required when consumer enabled; consumer: backend/src/modules/dataconnection/store/shopify/domain.ts:15
# SHOPIFY_REDIRECT_URI=
# Opt-in request for extended order scope; needs Shopify approval and reauthorization.
# Optional; required when consumer enabled; consumer: backend/src/modules/dataconnection/store/shopify/oauth.ts:26
# SHOPIFY_REQUEST_ALL_ORDERS=
# Node-to-Python stateless provider API base URL (local port 8002).
# Local default / profile setting; consumer: backend/src/modules/dataconnection/store/provider.client.ts:5
STORE_CONNECTOR_API_URL=http://127.0.0.1:8002
# Stable Node-only 32-byte AES-GCM key encoded as 64 hex characters; preserve across restarts.
