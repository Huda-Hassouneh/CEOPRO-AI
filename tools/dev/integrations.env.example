# Copy to .dev/integrations.env AFTER setup. This file contains names, never credentials.
# Restart after changes. Core DB/Redis/URL settings are managed; see docs/ENVIRONMENT_VARIABLES.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local development only. An ID is ignored while disabled. Never enable in production.
STRIPE_TEST_CLOCK_ENABLED=false
STRIPE_TEST_CLOCK_ID=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
HUGGINGFACE_API_TOKEN=
TAVILY_API_KEY=
APIFY_API_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Exact public HTTPS API callback registered in your test Shopify app:
# https://<your-api-tunnel>/onboarding/shopify/callback
SHOPIFY_REDIRECT_URI=
# Optional installed Chrome/Chromium executable for browser tests:
# CHROMIUM_PATH=
# Optional: only after installing models with setup --models.
# RAG_EMBEDDING_BACKEND=torch
# SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
